# Copy to Api/.env (git-ignored) and fill in. Never commit real values.
# `make env` creates Api/.env from this file with random JWT secrets.

# --- Server ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN="*"
# Only behind a reverse proxy: hop count ("1"), "loopback", a subnet, or "true".
# Off by default so clients cannot spoof their IP (logs, per-IP rate limits)
# with X-Forwarded-For.
TRUST_PROXY=

# --- Database / cache ---
# Host-side URLs (npm run dev / npm test outside Docker); docker compose overrides
# DATABASE_URL, REDIS_URL and SMTP_HOST for the api container.
DATABASE_URL="postgresql://musicroom:musicroom@localhost:5432/musicroom"
# Database used by `npm test` -- WIPED between test files, never point it at real data.
# Create it and push the schema once: `make test-db`
# (= DATABASE_URL=$TEST_DATABASE_URL npx prisma db push).
TEST_DATABASE_URL="postgresql://musicroom:musicroom@localhost:5432/musicroom_test"
REDIS_URL="redis://localhost:6379"

# --- Auth (REQUIRED: the API refuses to start without them) ---
# Two DIFFERENT random values of at least 32 characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# --- Google sign-in (Google Cloud console > APIs & Services > Credentials) ---
# OAuth client ids whose tokens the API accepts (the token `aud`/`azp` must be one
# of them). Set at least one; leave the others empty. Client ids are not secret but
# stay out of git. No client secret is needed: the API only verifies ID tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=
# DEV ONLY: enables the simulated Google login (POST /api/auth/oauth, /link-oauth),
# which trusts body-supplied ids. Only honoured when NODE_ENV is development or test.
ALLOW_DEV_OAUTH=false

# --- Mail (mailpit in docker compose; real SMTP in production) ---
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Rate limits (optional, see src/middleware/rateLimit.js and docs/SECURITY.md) ---
# Per limiter: RATE_LIMIT_<NAME>_MAX / RATE_LIMIT_<NAME>_WINDOW_MS with NAME in
# AUTH, API, JOIN_CODE, USER_SEARCH, FRIEND_REQUEST, VOTE, DEVICE_REGISTER.
# RATE_LIMIT_DISABLED=true turns them off for local tooling (ignored when NODE_ENV=production).
# RATE_LIMIT_DISABLED=false

# --- Host ports published by docker compose (`make up` reads this file) ---
# Change them when a port is already taken on your machine (5432 often is).
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
API_PORT=3000
EXPO_PORT=19000
EXPO_DEVTOOLS_PORT=19001
EXPO_UI_PORT=19002
METRO_PORT=8081
