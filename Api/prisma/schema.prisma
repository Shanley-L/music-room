generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

enum VoteLicense {
  EVERYONE
  INVITED_ONLY
  GEO_TIME_RESTRICTED
}

enum PlaybackStatus {
  IDLE
  PLAYING
  PAUSED
}

enum TrackStatus {
  QUEUED
  PLAYING
  PLAYED
}

model Room {
  id          String         @id @default(cuid())
  name        String
  visibility  RoomVisibility @default(PUBLIC)
  inviteCode  String?        @unique
  license     VoteLicense    @default(EVERYONE)

  latitude    Float?
  longitude   Float?
  radiusM     Int?
  voteStartAt DateTime?
  voteEndAt   DateTime?

  // Live playback (server is the source of truth). While PLAYING, the position is
  // now - playbackStartedAt; while PAUSED it is pausedPositionMs.
  playbackStatus    PlaybackStatus @default(IDLE)
  currentTrackId    String?
  playbackStartedAt DateTime?
  pausedPositionMs  Int            @default(0)

  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invites RoomInvite[]
  tracks  Track[]
}

model RoomInvite {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([roomId, userId])
}

model Track {
  id         String  @id @default(cuid())
  roomId     String
  room       Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  externalId String
  title      String
  artist     String
  album      String?
  preview    String?
  coverUrl   String?
  duration   Int?

  status      TrackStatus @default(QUEUED)
  voteCount   Int @default(0)
  version     Int @default(0)
  position    Int

  suggestedBy String
  createdAt   DateTime @default(now())

  votes Vote[]

  @@unique([roomId, externalId])
  @@index([roomId, position])
}

model Vote {
  id        String   @id @default(cuid())
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([trackId, userId])
}
enum PlaylistVisibility {
  PUBLIC
  PRIVATE
}

enum PlaylistEditLicense {
  EVERYONE
  INVITED_ONLY
}

model Playlist {
  id          String              @id @default(cuid())
  name        String
  description String?
  visibility  PlaylistVisibility  @default(PUBLIC)
  license     PlaylistEditLicense @default(EVERYONE)
  inviteCode  String?             @unique
  coverUrl    String?
  version     Int                 @default(0)

  ownerId     String              @default("anonymous")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tracks      PlaylistTrack[]
  invites     PlaylistInvite[]
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  externalId String
  title      String
  artist     String
  album      String?
  coverUrl   String?
  preview    String?
  duration   Int?

  position   Int
  addedBy    String   @default("anonymous")
  createdAt  DateTime @default(now())

  @@index([playlistId, position])
}

model PlaylistInvite {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  userId     String
  canEdit    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([playlistId, userId])
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  password             String?
  name                 String
  avatarUrl            String?
  isEmailVerified      Boolean        @default(false)
  verificationCode     String?
  resetPasswordCode    String?
  resetPasswordExpires DateTime?
  googleId             String?        @unique
  facebookId           String?        @unique

  // Profile data according to subject
  bio                  String?
  friendsInfo          String?
  privateInfo          String?
  musicPreferences     String?

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  refreshTokens        RefreshToken[]
  logs                 SystemLog[]

  devices              Device[]
  sentFriendRequests     Friendship[]        @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]        @relation("FriendshipAddressee")
  receivedDelegations    ControlDelegation[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SystemLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  method     String
  endpoint   String
  platform   String?
  device     String?
  appVersion String?
  ip         String?
  statusCode Int?
  createdAt  DateTime @default(now())
}

// Music Control Delegation (subject V.2.2): devices attached to an account,
// friendships, and per-device control licenses granted to friends.

model Device {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  platform       String
  installationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  delegations ControlDelegation[]

  @@unique([userId, installationId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  // Both user ids sorted and joined: one relation per pair, whatever its direction.
  pairKey     String           @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model ControlDelegation {
  id           String   @id @default(cuid())
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  delegateId   String
  delegate     User     @relation(fields: [delegateId], references: [id], onDelete: Cascade)
  canPlayPause Boolean  @default(true)
  canSkip      Boolean  @default(true)
  canVolume    Boolean  @default(true)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([deviceId, delegateId])
  @@index([delegateId, active])
}
