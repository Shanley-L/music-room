generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String?  // Nullable for OAuth users
  googleId        String?  @unique
  facebookId      String?  @unique
  isEmailVerified Boolean  @default(false)

  publicBio       String?
  friendsOnlyBio  String?
  privateNotes    String?
  musicPrefs      String[] 

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rooms           Room[]
  roomInvites     RoomInvite[]
  suggestedTracks Track[]
  votes           Vote[]
  playlists       Playlist[]
  playlistTracks  PlaylistTrack[]
  playlistInvites PlaylistInvite[]
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

enum VoteLicense {
  EVERYONE
  INVITED_ONLY
  GEO_TIME_RESTRICTED
}

model Room {
  id          String         @id @default(cuid())
  name        String
  visibility  RoomVisibility @default(PUBLIC)
  inviteCode  String?        @unique
  license     VoteLicense    @default(EVERYONE)

  latitude    Float?
  longitude   Float?
  radiusM     Int?
  voteStartAt DateTime?
  voteEndAt   DateTime?

  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  invites     RoomInvite[]
  tracks      Track[]
}

model RoomInvite {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  @@unique([roomId, userId])
}

model Track {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  externalId  String
  title       String
  artist      String
  album       String?
  preview     String?
  duration    Int?

  voteCount   Int      @default(0)
  version     Int      @default(0)
  position    Int

  suggestedBy String
  user        User     @relation(fields: [suggestedBy], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())

  votes       Vote[]

  @@unique([roomId, externalId])
  @@index([roomId, position])
}

model Vote {
  id        String   @id @default(cuid())
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  @@unique([trackId, userId])
}

enum PlaylistVisibility {
  PUBLIC
  PRIVATE
}

enum PlaylistEditLicense {
  EVERYONE
  INVITED_ONLY
}

model Playlist {
  id          String              @id @default(cuid())
  name        String
  description String?
  visibility  PlaylistVisibility  @default(PUBLIC)
  license     PlaylistEditLicense @default(EVERYONE)
  inviteCode  String?             @unique
  coverUrl    String?
  version     Int                 @default(0)

  ownerId     String
  owner       User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tracks      PlaylistTrack[]
  invites     PlaylistInvite[]
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  externalId String
  title      String
  artist     String
  album      String?
  coverUrl   String?
  preview    String?
  duration   Int?

  position   Int
  
  // Linked to User
  addedBy    String
  user       User     @relation(fields: [addedBy], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())

  @@index([playlistId, position])
}

model PlaylistInvite {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  canEdit    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([playlistId, userId])
}