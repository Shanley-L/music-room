# Copy to App/.env (git-ignored). Never commit real values.
# Google OAuth client ids (Google Cloud console > APIs & Services > Credentials).
# Use the same ids as GOOGLE_CLIENT_ID* in Api/.env: the API rejects tokens issued
# for any other client. EXPO_PUBLIC_GOOGLE_CLIENT_ID is the fallback for platforms
# without their own id. Android/iOS clients use the package / bundle id
# com.musicroom.app (App/app.json). Restart `expo start` after changing them.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
